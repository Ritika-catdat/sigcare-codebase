# Copy to .env and fill in. .env is git-ignored; never commit real values.
# On the staging EC2 the real .env lives only on the server.

# ------------------------------------------------------------------
# Used by the API today
# ------------------------------------------------------------------
APP_ENV=local                      # local | dev | staging | production
SIGCARE_HOST_PORT=8000             # host port published by docker compose
SIGCARE_WORKERS=1                  # uvicorn workers (CPU-bound pipeline; keep <= vCPUs)
SIGCARE_MAX_UPLOAD_BYTES=26214400  # 25 MB upload limit
SIGCARE_API_OUTPUT_DIR=/app/api_outputs   # inside the container; do not change for compose
IMAGE_TAG=latest

# ------------------------------------------------------------------
# Planned (from the Sigcare infrastructure documents). Not read by the
# code yet; kept here so staging .env is ready as the pipeline grows.
# On EC2 prefer the instance IAM role over static AWS keys.
# ------------------------------------------------------------------
AWS_REGION=eu-west-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=                    # e.g. sigcare-test-bucket (staging)
S3_RAW_OCR_BUCKET=
BEDROCK_MODEL_ID=

# Database (Docker on EC2 for staging, RDS for production)
DB_HOST=
DB_NAME=
DB_USER=
DB_PASS=

# ConX sandbox
CONX_API_URL=
CONX_API_KEY=
CONX_CLIENT_ID=
CONX_CLIENT_SECRET=

# Microsoft 365 prescription inbox (Graph API)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MAILBOX_ADDRESS=
POLL_INTERVAL_SECONDS=120
