# Copy to .env and fill in. .env is git-ignored; never commit real values.
# On the staging EC2 the real .env lives only on the server.

# ------------------------------------------------------------------
# Used by the API today
# ------------------------------------------------------------------
APP_ENV=local                      # local | dev | staging | production
SIGCARE_HOST_PORT=8000             # host port published by docker compose
SIGCARE_WORKERS=1                  # uvicorn workers (CPU-bound pipeline; keep <= vCPUs)
SIGCARE_MAX_UPLOAD_BYTES=26214400  # 25 MB upload limit
SIGCARE_API_OUTPUT_DIR=/app/api_outputs   # inside the container; do not change for compose
IMAGE_TAG=latest
SIGCARE_JOB_WORKERS=1              # whole jobs processed in parallel (background threads)
SIGCARE_LOG_LEVEL=INFO

# ------------------------------------------------------------------
# S3 worker (docker compose service "worker")
# Layout: <bucket>/<yyyy>/<MMM>/<dd>/{input,intermediary/<file>,processed}
# Test and prod use different buckets: set the bucket per environment.
# Older names S3_BUCKET_NAME, S3_POLL_INTERVAL_SECONDS and S3_WORKER_DRY_RUN
# are still accepted.
# ------------------------------------------------------------------
SIGCARE_S3_BUCKET=
# Optional folder in front of <yyyy>, e.g. "sigcare" -> sigcare/2026/Oct/27/input/
SIGCARE_S3_ROOT_PREFIX=
SIGCARE_S3_MONTH_CASE=title          # title (Oct, i.e. yyyy/MMM/dd) | lower (oct) | upper (OCT)
SIGCARE_S3_TIMEZONE=Europe/London    # decides which day folder is "today"
SIGCARE_WATCH_INTERVAL_SECONDS=60    # how often input/ is checked
SIGCARE_WATCH_LOOKBACK_DAYS=1        # also check yesterday (files dropped near midnight)
SIGCARE_WATCH_KEEP_LOCAL=false       # keep local working copies after upload
SIGCARE_WATCH_DRY_RUN=false          # true = only log eligible files, process nothing
SIGCARE_WATCH_DPI=220

# ------------------------------------------------------------------
# AWS Textract extraction (async, via a private S3 staging bucket)
# On EC2 use the instance IAM role, not static keys. If running in
# Docker on EC2, set the IMDS hop limit to 2 (see DEPLOYMENT.md).
# ------------------------------------------------------------------
# Optional separate bucket for temporary Textract uploads; defaults to
# SIGCARE_S3_BUCKET. Must be in the same region as AWS_REGION.
SIGCARE_TEXTRACT_STAGING_BUCKET=
SIGCARE_TEXTRACT_CONCURRENCY=4     # prescriptions sent to Textract in parallel
POLL_SECONDS=5                     # Textract job polling interval
TIMEOUT_SECONDS=300                # max wait per Textract job

# ------------------------------------------------------------------
# AWS region is used by Textract and S3. The rest of this block is
# planned (from the Sigcare infrastructure documents) and not read yet.
# On EC2 prefer the instance IAM role over static AWS keys.
# ------------------------------------------------------------------
AWS_REGION=eu-west-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=                    # e.g. sigcare-test-bucket (staging)
S3_RAW_OCR_BUCKET=
BEDROCK_MODEL_ID=

# Database (Docker on EC2 for staging, RDS for production)
DB_HOST=
DB_NAME=
DB_USER=
DB_PASS=

# ConX sandbox
CONX_API_URL=
CONX_API_KEY=
CONX_CLIENT_ID=
CONX_CLIENT_SECRET=

# Microsoft 365 prescription inbox (Graph API)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MAILBOX_ADDRESS=
POLL_INTERVAL_SECONDS=120
